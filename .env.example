# ==============================================================================
# DUO SPA - Environment Variables Template
#
# IMPORTANT:
# 1. Copy this file to '.env.local' for local development.
# 2. Never commit '.env.local' or paste real secrets into public chats or Git.
# 3. In production, configure these variables directly in the Vercel Dashboard
#    (Settings -> Environment Variables).
# ==============================================================================

# MongoDB Atlas Connection String
# Obtain from MongoDB Atlas -> Clusters -> Connect -> Drivers (Node.js)
# Replace <username> and <password> with your actual Atlas database user credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/duo_spa?retryWrites=true&w=majority

# Target Database Name (default: duo_spa)
MONGODB_DB_NAME=duo_spa

# Session Secret for Admin JWT Tokens
# Generate a secure 32+ character random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your-secure-random-32-char-secret-here

# One-Time Admin Setup (Used strictly by scripts/seed.ts)
# Specify your real administrator email and a strong initial password.
# Once seeded, you can remove the password from your .env.local file.
ADMIN_EMAIL=your-email@example.com
ADMIN_INITIAL_PASSWORD=ChooseAStrongPasswordHere123!

# Runtime environment (development | production)
NODE_ENV=development
